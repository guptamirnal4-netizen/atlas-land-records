# Base URL of the deployed Bhoomi backend (the FastAPI app in bhoomimonitor/).
# No trailing slash. Local dev: http://127.0.0.1:8000
ATLAS_API_BASE_URL=

# Must equal ATLAS_API_KEY configured on the backend. Server-side only:
# never prefix with NEXT_PUBLIC_ - it must not reach the browser.
ATLAS_API_KEY=
